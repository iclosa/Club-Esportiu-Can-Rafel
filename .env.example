# Còpia aquest fitxer com a `.env` i omple els valors.
# IMPORTANT: en una web estàtica aquests valors acaben dins del JS del
# navegador. No hi posis secrets d'Odoo.

# Endpoint del formulari de Formspree (https://formspree.io/f/xxxxxx)
VITE_FORMSPREE_ENDPOINT=

# Backend antic d’Odoo; no s’utilitza en les reserves ni les altes de production
# Exemple: https://kmbcptnavfwirvvqfbdc.supabase.co/functions/v1
VITE_RESERVATIONS_API_URL=

# Disponibilitat pública de Google Calendar. Restringir la clau per domini
# i a Google Calendar API a Google Cloud. Els quatre calendaris han de ser públics.
VITE_GCAL_API_KEY=

# URL pública del web (sense barra final). Necessària per a les imatges i enllaços
# absoluts de les previsualitzacions de WhatsApp. Per defecte: https://club-esportiu-can-rafel.vercel.app
VITE_SITE_URL=
